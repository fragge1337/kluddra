<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Strict HTTPS required for all public internet traffic -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Local-only HTTP is additionally gated by explicit user opt-in and RFC1918 IP validation in UrlSecurityPolicy -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">local</domain>
        <domain includeSubdomains="true">home.arpa</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
